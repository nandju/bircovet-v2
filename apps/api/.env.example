# --- Base de donnees Neon (PostgreSQL) ---
# Adresse "pooled" (avec -pooler dans l'hote) : utilisee par l'application.
DATABASE_URL=
# Adresse directe (sans -pooler) : utilisee par les migrations Prisma.
DIRECT_URL=
# Adresse directe de la base de test cliva_test.
DATABASE_URL_TEST=

# --- Secrets JWT : generer avec `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"` ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Divers ---
# Origine autorisee par CORS (le front Next.js).
CORS_ORIGIN=http://localhost:3000
# Mot de passe attribue aux comptes crees par le script de seed
# (changement obligatoire a la premiere connexion).
SEED_PASSWORD=
