# Mini Marc — assistant IA (Google Gemini, côté serveur uniquement)
# Obtenir une clé : https://aistudio.google.com/apikey
# ⚠️ Ne jamais préfixer par NEXT_PUBLIC_ : la clé ne doit pas passer au navigateur.
GEMINI_API_KEY=

# Modèles (offre gratuite au moment de l'écriture — vérifier la disponibilité
# pour votre compte : https://ai.google.dev/gemini-api/docs/models)
# Conversation et rédaction — alternative : gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite
# Transcription audio dédiée ; si indisponible, le serveur bascule
# automatiquement sur GEMINI_MODEL (compréhension audio).
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
